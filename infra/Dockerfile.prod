FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@12.4.1 --activate
WORKDIR /app

FROM base AS builder
COPY . .
RUN pnpm install --no-frozen-lockfile
RUN pnpm build

# Target: API Service
FROM base AS api
WORKDIR /app
COPY --from=builder /app ./
ENV NODE_ENV=production
EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]

# Target: Worker Service
FROM base AS worker
WORKDIR /app
COPY --from=builder /app ./
ENV NODE_ENV=production
CMD ["node", "apps/worker/dist/main.js"]

# Target: Admin Web
FROM base AS admin
WORKDIR /app
COPY --from=builder /app ./
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@propops/admin", "start", "-p", "3000"]

# Target: Public Invoice Web
FROM base AS public-invoice
WORKDIR /app
COPY --from=builder /app ./
ENV NODE_ENV=production
EXPOSE 3002
CMD ["pnpm", "--filter", "@propops/public-invoice", "start", "-p", "3002"]

# Copy to repository root as .env.staging, chmod 600, and fill privately on the VM.
# Never commit .env.staging or post its contents to a chat.
# Domain without scheme. Temporary testing option: api.<EXTERNAL_IP>.sslip.io
HABI_API_DOMAIN=api.REPLACE_WITH_IP.sslip.io
# Exact https:// origin of the Vercel Habi Admin deployment.
HABI_ADMIN_ORIGIN=https://REPLACE_WITH_HABI_VERCEL_DOMAIN
# Obtain from Neon Console -> habi-staging branch -> neondb -> Connection details.
# Use a pooled URI with sslmode=require. Quote the value if it has special characters.
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'

# Generate each secret with openssl rand -hex 32.
AUTH_SECURITY_HMAC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
INTERNAL_WORKER_TOKEN=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
OBSERVABILITY_METRICS_TOKEN=REPLACE_WITH_ANOTHER_64_HEX_CHARACTERS
# Base64 of 32 random bytes, same stable key on both workers. Generate with openssl rand -base64 32.
ZALO_SESSION_MASTER_KEY_BASE64=REPLACE_WITH_BASE64_32_BYTES
# Optional but recommended when enabling MFA: openssl rand -base64 32
AUTH_TOTP_ENCRYPTION_KEY=
# Optional transactional email for real-user registration and password resets.
AUTH_EMAIL_FROM=
RESEND_API_KEY=
GOOGLE_CLIENT_ID=
# If using an owner bootstrap once, set these only when running that command:
# BOOTSTRAP_OWNER_EMAIL=
# BOOTSTRAP_OWNER_DISPLAY_NAME=
# BOOTSTRAP_OWNER_PASSWORD=
# BOOTSTRAP_ORGANIZATION_NAME=Habi staging
# BOOTSTRAP_ORGANIZATION_SLUG=habi-staging

{
  "name": "@propops/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "zalo:bootstrap-session": "tsx src/zalo-session-bootstrap.ts",
    "zalo:send-test": "tsx src/zalo-send-test.ts"
  },
  "dependencies": {
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "tsx": "^4.20.0",
    "typescript": "7.0.2"
  }
}

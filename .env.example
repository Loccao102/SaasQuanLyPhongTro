POSTGRES_DB=propops
POSTGRES_USER=propops
POSTGRES_PASSWORD=propops

API_PORT=4000
DATABASE_URL=postgresql://propops:propops@localhost:5432/propops
DATABASE_POOL_MAX=10
DB_SLOW_OPERATION_THRESHOLD_MS=250
REDIS_URL=redis://localhost:6379

# Browser authentication
AUTH_SESSION_TTL_DAYS=30
AUTH_SESSION_IDLE_TTL_HOURS=24
AUTH_SESSION_TOUCH_INTERVAL_MINUTES=5
AUTH_COOKIE_SECURE=false
AUTH_SESSION_COOKIE_NAME=
AUTH_CSRF_COOKIE_NAME=
AUTH_GOOGLE_NONCE_COOKIE_NAME=

# Hashing secret used for privacy-preserving auth abuse keys/security telemetry.
# Production startup requires at least 32 random characters.
AUTH_SECURITY_HMAC_KEY=

# Distributed authentication abuse controls.
AUTH_LOGIN_RATE_WINDOW_SECONDS=900
AUTH_LOGIN_RATE_MAX_PER_EMAIL=30
AUTH_LOGIN_RATE_MAX_PER_IP=120
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_REGISTER_RATE_MAX_PER_IP=20
AUTH_GOOGLE_RATE_WINDOW_SECONDS=900
AUTH_GOOGLE_RATE_MAX_PER_IP=60
AUTH_GOOGLE_CHALLENGE_WINDOW_SECONDS=900
AUTH_GOOGLE_CHALLENGE_MAX_PER_IP=120
AUTH_PASSWORD_CHANGE_WINDOW_SECONDS=3600
AUTH_PASSWORD_CHANGE_MAX_PER_WINDOW=10
AUTH_PASSWORD_RESET_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_MAX_PER_IP=30
AUTH_PASSWORD_RESET_MAX_PER_EMAIL=6
AUTH_PASSWORD_RESET_CONFIRM_WINDOW_SECONDS=3600
AUTH_PASSWORD_RESET_CONFIRM_MAX_PER_IP=30
AUTH_EMAIL_VERIFY_WINDOW_SECONDS=3600
AUTH_EMAIL_VERIFY_MAX_PER_IP=60
PUBLIC_INVOICE_RATE_WINDOW_SECONDS=900
PUBLIC_INVOICE_RATE_MAX_PER_IP=300
PUBLIC_MAINTENANCE_RATE_WINDOW_SECONDS=3600
PUBLIC_MAINTENANCE_RATE_MAX_PER_IP=30
AUTH_SECURITY_EVENT_RETENTION_DAYS=90

# Number of trusted reverse proxies in front of the API. Keep 0 for direct/local access.
TRUST_PROXY_HOPS=0

# Google Identity Services / OpenID Connect Web client ID.
# Habi only consumes the signed ID token for authentication; it does not keep
# Google access/refresh tokens unless a future Google API integration needs them.
GOOGLE_CLIENT_ID=

# Transactional auth email. In development, missing Resend settings log the
# verification/reset URL to the API console. Production requires all 3 values
# before password registration/recovery is exposed by /auth/config.
AUTH_PUBLIC_APP_URL=http://localhost:3000
AUTH_EMAIL_FROM=Habi <onboarding@example.com>
RESEND_API_KEY=
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30

# TOTP MFA. Generate a random 32-byte key and store it as base64 in production.
AUTH_TOTP_ENCRYPTION_KEY=
AUTH_MFA_CHALLENGE_TTL_MINUTES=5
AUTH_MFA_VERIFY_WINDOW_SECONDS=900
AUTH_MFA_VERIFY_MAX_PER_IP=60
AUTH_MFA_SETUP_WINDOW_SECONDS=3600
AUTH_MFA_SETUP_MAX_PER_USER=10

# One-time/idempotent owner bootstrap
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_DISPLAY_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_ORGANIZATION_NAME=My rental portfolio
BOOTSTRAP_ORGANIZATION_SLUG=my-rental-portfolio
BOOTSTRAP_ORGANIZATION_TYPE=INDIVIDUAL

# Development-only principal fallbacks; keep empty when testing real auth
CMS_DEV_USER_ID=00000000-0000-0000-0000-000000000901
ADMIN_DEV_USER_ID=
ADMIN_DEV_ORGANIZATION_ID=
NEXT_PUBLIC_ADMIN_ORGANIZATION_ID=
NEXT_PUBLIC_ADMIN_API_BASE_URL=/api
NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=
ADMIN_API_PROXY_TARGET=http://localhost:4000/api
NEXT_PUBLIC_STAFF_ORGANIZATION_ID=
NEXT_PUBLIC_STAFF_API_BASE_URL=/api
STAFF_API_PROXY_TARGET=http://localhost:4000/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_PUBLIC_INVOICE_BASE_URL=http://localhost:3002
PUBLIC_INVOICE_BASE_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

INTERNAL_WORKER_TOKEN=replace-with-a-long-random-worker-token
OBSERVABILITY_METRICS_TOKEN=replace-with-a-separate-long-random-metrics-token
INTERNAL_API_BASE_URL=http://localhost:4000/api
WORKER_PROVIDER=DEV_MANUAL_REVIEW
WORKER_POLL_INTERVAL_MS=1500
WORKER_HEARTBEAT_INTERVAL_MS=15000
# API-side stale RUNNING recovery timeout for notification attempts.
NOTIFICATION_RUNNING_TIMEOUT_SECONDS=600
WORKER_ID=
WORKER_ROLE=NOTIFICATION

ZALO_BASE_URL=https://chat.zalo.me/
ZALO_HEADLESS=true
ZALO_SESSION_PATH=.runtime-secrets/zalo/session.enc
ZALO_SESSION_KEY_BASE64=
ZALO_NAVIGATION_TIMEOUT_MS=30000
ZALO_SELECTOR_TIMEOUT_MS=5000
ZALO_VERIFICATION_TIMEOUT_MS=10000
ZALO_LOGIN_INDICATORS=
ZALO_CAPTCHA_INDICATORS=
ZALO_SEARCH_INPUT_SELECTORS=
ZALO_MESSAGE_EDITOR_SELECTORS=
ZALO_SEND_BUTTON_SELECTORS=

BILLING_SWEEP_INTERVAL_MS=60000
BILLING_SWEEP_LIMIT=100
BILLING_WEBHOOK_PROVIDER=DEV_JSON_BANK
BILLING_WEBHOOK_POLL_INTERVAL_MS=1500
WEBHOOK_MAX_BODY_BYTES=262144
DEV_BILLING_WEBHOOK_SECRET=replace-with-at-least-16-random-characters

RENTER_PAYMENT_WEBHOOK_PROVIDER=DEV_JSON_BANK
RENTER_PAYMENT_WEBHOOK_POLL_INTERVAL_MS=1500
SEPAY_RENTER_WEBHOOK_SECRET=
# Temporary overlap secret used only during webhook HMAC rotation.
SEPAY_RENTER_WEBHOOK_SECRET_PREVIOUS=

# SePay API v2 reconciliation sweep (production opt-in)
SEPAY_RECONCILIATION_ENABLED=false
SEPAY_API_BASE_URL=https://userapi.sepay.vn/v2
SEPAY_API_TOKEN=
SEPAY_RECONCILIATION_SCOPE_KEY=default
SEPAY_RECONCILIATION_INTERVAL_MS=900000
SEPAY_RECONCILIATION_INITIAL_LOOKBACK_HOURS=24

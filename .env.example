POSTGRES_DB=propops
POSTGRES_USER=propops
POSTGRES_PASSWORD=propops

API_PORT=4000
DATABASE_URL=postgresql://propops:propops@localhost:5432/propops
DATABASE_POOL_MAX=10
DB_SLOW_OPERATION_THRESHOLD_MS=250
REDIS_URL=redis://localhost:6379

CMS_DEV_USER_ID=00000000-0000-0000-0000-000000000901
ADMIN_DEV_USER_ID=
ADMIN_DEV_ORGANIZATION_ID=
NEXT_PUBLIC_ADMIN_ORGANIZATION_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

INTERNAL_WORKER_TOKEN=replace-with-a-long-random-worker-token
OBSERVABILITY_METRICS_TOKEN=replace-with-a-separate-long-random-metrics-token
INTERNAL_API_BASE_URL=http://localhost:4000/api
WORKER_PROVIDER=DEV_MANUAL_REVIEW
WORKER_POLL_INTERVAL_MS=1500
WORKER_HEARTBEAT_INTERVAL_MS=15000
WORKER_ID=
WORKER_ROLE=NOTIFICATION

# Zalo Playwright edge adapter
# Generate a 32-byte base64 key, e.g. with: openssl rand -base64 32
ZALO_BASE_URL=https://chat.zalo.me/
ZALO_HEADLESS=true
ZALO_SESSION_PATH=.runtime-secrets/zalo/session.enc
ZALO_SESSION_KEY_BASE64=
ZALO_NAVIGATION_TIMEOUT_MS=30000
ZALO_SELECTOR_TIMEOUT_MS=5000
ZALO_VERIFICATION_TIMEOUT_MS=10000
# Optional selector overrides; separate fallback selectors with ||
ZALO_LOGIN_INDICATORS=
ZALO_CAPTCHA_INDICATORS=
ZALO_SEARCH_INPUT_SELECTORS=
ZALO_MESSAGE_EDITOR_SELECTORS=
ZALO_SEND_BUTTON_SELECTORS=

BILLING_SWEEP_INTERVAL_MS=60000
BILLING_SWEEP_LIMIT=100
BILLING_WEBHOOK_PROVIDER=DEV_JSON_BANK
BILLING_WEBHOOK_POLL_INTERVAL_MS=1500
DEV_BILLING_WEBHOOK_SECRET=replace-with-at-least-16-random-characters
